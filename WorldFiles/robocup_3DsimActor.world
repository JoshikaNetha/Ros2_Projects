<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <!-- Remove the grid -->
    <scene>
      <grid>false</grid>
    </scene>
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <!-- RoboCup 3D simulator field -->
    <include>
      <uri>model://robocup_3Dsim_field</uri>
    </include>
    <!-- RoboCup 3D simulator left goal -->
    <include>
      <pose>-15.0 0 0 0 0 3.1416</pose>
      <uri>model://robocup_3Dsim_goal</uri>
    </include>
    <!-- RoboCup 3D simulator right goal -->
    <include>
      <pose>15.0 0 0 0 0 0</pose>
      <uri>model://robocup_3Dsim_goal</uri>
    </include>
    <!-- RoboCup 3D simulator ball -->
    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://robocup_3Dsim_ball</uri>
    </include>
        <actor name="actor">
      <pose>2 2 2 0 0 0</pose>
      <skin>
        <filename>file://media/models/walk.dae</filename>
      </skin>
      <animation name="anim">
        <filename>cmu-13_26.bvh</filename>
      </animation>
      <script>
        <trajectory id="0" type="anim">
          <waypoint>
            <time>0</time>
            <pose>2 2 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>10</time>
            <pose>0 1 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
